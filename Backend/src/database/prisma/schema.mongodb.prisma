generator client {
  provider = "prisma-client-js"
  output   = "../../generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  discordId String  @unique
  username String
  avatar String
  token String
  boards     Board[]  @relation("UserBoards")
}

model Board {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  ownerId       String
  owner         User      @relation("UserBoards", fields: [ownerId], references: [id])
  title         String
  description   String
  anonymous     Boolean
  allowMultiple Boolean
  theme         String
  background    String
  messages      Message[] @relation("BoardMessages")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  boardId   String
  board     Board    @relation("BoardMessages", fields: [boardId], references: [id])
  userId    String?
  username  String
  message   String
  image     String?
  timestamp DateTime @default(now())
}